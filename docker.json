{
    "schemaVersion": 3,
    "namespace": "$DOCKER_NAMESPACE",
    "image": "$DOCKER_IMAGE",
    "description": "Jenkins inbound agents with Java 25, Git, Docker CLI, and build tools for Linux and Windows",
    "overviewFile": "README.md",
    "context": ".",
    "cleanupWindowsRunner": true,
    "matrix": {
        "product": {
            "tags": {
                "latest": {}
            }
        },
        "os": {
            "dockerfile": "{{matrix.os}}/Dockerfile",
            "tags": {
                "linux": {
                    "runner": "ubuntu-latest",
                    "matrix": {
                        "architecture": {
                            "tags": {
                                "amd64": {}
                            }
                        }
                    }
                },
                "windows": {
                    "runner": "windows-latest",
                    "matrix": {
                        "release": {
                            "tags": {
                                "ltsc2019": {
                                    "buildArgs": {
                                        "BUILD_OS_BASE": "1809"
                                    }
                                },
                                "ltsc2022": {
                                    "buildArgs": {
                                        "BUILD_OS_BASE": "ltsc2022"
                                    }
                                }
                            },
                            "buildArgs": {
                                "OS_BASE": "{{matrix.release}}"
                            }
                        }
                    },
                    "dockerfile": "windows/Dockerfile"
                }
            }
        }
    }
}
